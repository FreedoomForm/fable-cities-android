<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:label="Fable Cities"
        android:supportsRtl="true"
        android:theme="@style/Theme.FableCities">
        <!-- The NATIVE GLES renderer is the app entry point (track B promoted to launcher).
             The bundled 1:1 web build remains installed and CI-gated as ParityActivity,
             reachable from the native HUD chip and by component name. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ParityActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|navigation"
            android:exported="true"
            android:screenOrientation="landscape" />
    </application>
</manifest>
