<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FableCities" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:colorAccent">#4FC3F7</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:navigationBarColor">#0B0F14</item>
        <item name="android:statusBarColor">#0B0F14</item>
        <item name="android:windowLightNavigationBar">false</item>
        <!-- The SurfaceView hole shows the window background until the first GL frame is
             composited — the Light theme made that WHITE (the "white screen" on slow devices
             while the world builds). The scene palette is #0B0F14; boot must match it. -->
        <item name="android:windowBackground">#0B0F14</item>
        <item name="android:colorBackground">#0B0F14</item>
    </style>
</resources>
